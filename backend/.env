# App Settings
APP_NAME="Intellex AI"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production-1234567890

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=intellex_ai

# Database Pooling Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Database URL overrides
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intellex_ai
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intellex_ai

# CORS configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://localhost:3000", "http://127.0.0.1:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=CONSOLE
LOG_ROTATION_MAX_BYTES=5242880
LOG_ROTATION_BACKUP_COUNT=5

# Storage Limits
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes
MAX_STORAGE_TARGET_MB=450

# Clerk Authentication Settings
CLERK_SECRET_KEY=sk_test_51ClerkSecretKeyHerePlaceholder
CLERK_PUBLISHABLE_KEY=pk_test_51ClerkPublishableKeyHerePlaceholder
CLERK_JWT_ISSUER=https://clerk.your-domain.clerk.accounts.dev

# AI Conversation Engine Settings
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_MODEL=mock-model
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# Latest Internet Search Settings
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SEARCH_DEFAULT_LIMIT=5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache Settings
CACHE_BACKEND=in_memory
CACHE_DEFAULT_TTL=300

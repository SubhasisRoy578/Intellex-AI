# Ignore Git and OS assets
.git
.github
.gitignore
.DS_Store
Thumbs.db

# Ignore Python caches and temporary files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Ignore local persistence assets (let containers manage their own)
backend/uploads/*
!backend/uploads/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# Ignore IDE configs
.vscode/
.idea/
